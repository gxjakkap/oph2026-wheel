{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [],
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["worker", "shared", "worker-configuration.d.ts"],
	"exclude": ["**/*.test.ts"]
}
